{
  "LambdaBasicExecution": {
    "policy_content": {
      "Statement": [
        {
          "Action": [
            "logs:CreateLogGroup",
            "logs:CreateLogStream",
            "logs:PutLogEvents",
            "cognito-idp:DescribeUserPool",
            "cognito-idp:GetUser",
            "cognito-idp:ListUsers",
            "cognito-idp:AdminCreateUser",
            "cognito-idp:AdminInitiateAuth",
            "cognito-idp:GetIdentityProviderByIdentifier",
            "cognito-idp:ListUserPools",
            "cognito-idp:ListUserPoolClients",
            "cognito-idp:AdminSetUserPassword",
            "cognito-idp:AdminRespondToAuthChallenge",
            "cognito-idp:AdminUserGlobalSignOut"
          ],
          "Effect": "Allow",
          "Resource": "*"
        }
      ],
      "Version": "2012-10-17"
    },
    "resource_type": "iam_policy"
  },
  "BasicExecutionRole": {
    "predefined_policies": [],
    "principal_service": "lambda",
    "custom_policies": [
      "LambdaBasicExecution"
    ],
    "resource_type": "iam_role",
    "allowed_accounts": [
      "${account_id}"
    ]
  },
  "${userpool_name}": {
    "resource_type": "cognito_idp",
    "password_policy": {
      "minimum_length": 8,
      "require_uppercase": true,
      "require_symbols": true,
      "require_lowercase": true,
      "require_numbers": true
    },
    "auto_verified_attributes": [],
    "sms_configuration": {},
    "username_attributes": [],
    "custom_attributes": [],
    "client": {
      "client_name": "client-app",
      "generate_secret": false,
      "explicit_auth_flows": [
        "ALLOW_ADMIN_USER_PASSWORD_AUTH",
        "ALLOW_CUSTOM_AUTH",
        "ALLOW_USER_SRP_AUTH",
        "ALLOW_REFRESH_TOKEN_AUTH"
      ]
    }
  },
  "syndicate-demo-api": {
    "resource_type": "api_gateway",
    "deploy_stage": "api",
    "dependencies": [
      {
        "resource_name": "lambda_example",
        "resource_type": "lambda"
      },
      {
        "resource_name": "${userpool_name}",
        "resource_type": "cognito_idp"
      }
    ],
    "authorizers": {
      "authorizer": {
        "type": "COGNITO_USER_POOLS",
        "identity_source": "method.request.header.Authorization",
        "user_pools": [
          "${userpool_name}"
        ],
        "ttl": 300
      }
    },
    "resources": {
      "/objects/public": {
        "enable_cors": {
          "state": false
        },
        "GET": {
          "enable_proxy": true,
          "authorization_type": "NONE",
          "integration_type": "lambda",
          "lambda_name": "lambda_example",
          "api_key_required": false,
          "method_request_parameters": {},
          "integration_request_body_template": {},
          "responses": [],
          "integration_responses": [],
          "default_error_pattern": true
        }
      },
      "/objects/secured-by-id-token": {
        "enable_cors": {
          "state": false
        },
        "GET": {
          "enable_proxy": true,
          "authorization_type": "authorizer",
          "integration_type": "lambda",
          "lambda_name": "lambda_example",
          "api_key_required": false,
          "method_request_parameters": {},
          "integration_request_body_template": {},
          "responses": [],
          "integration_responses": [],
          "default_error_pattern": true
        }
      },
      "/objects/secured-by-access-token": {
        "enable_cors": {
          "state": false
        },
        "GET": {
          "enable_proxy": true,
          "authorization_type": "authorizer",
          "authorization_scopes": [
            "aws.cognito.signin.user.admin"
          ],
          "integration_type": "lambda",
          "lambda_name": "lambda_example",
          "api_key_required": false,
          "method_request_parameters": {},
          "integration_request_body_template": {},
          "responses": [],
          "integration_responses": [],
          "default_error_pattern": true
        }
      },
      "/auth/sign-up": {
        "enable_cors": {
          "state": true
        },
        "POST": {
          "enable_proxy": true,
          "authorization_type": "NONE",
          "integration_type": "lambda",
          "lambda_name": "lambda_example",
          "api_key_required": false,
          "method_request_parameters": {},
          "integration_request_body_template": {},
          "responses": [],
          "integration_responses": [],
          "default_error_pattern": true,
          "integration_passthrough_behavior": "WHEN_NO_TEMPLATES"
        }
      },
      "/auth/sign-in": {
        "enable_cors": {
          "state": true
        },
        "POST": {
          "enable_proxy": true,
          "authorization_type": "NONE",
          "integration_type": "lambda",
          "lambda_name": "lambda_example",
          "api_key_required": false,
          "method_request_parameters": {},
          "integration_request_body_template": {},
          "responses": [],
          "integration_responses": [],
          "default_error_pattern": true,
          "integration_passthrough_behavior": "WHEN_NO_TEMPLATES"
        }
      },
      "/auth/refresh-token": {
        "enable_cors": {
          "state": true
        },
        "POST": {
          "enable_proxy": true,
          "authorization_type": "NONE",
          "integration_type": "lambda",
          "lambda_name": "lambda_example",
          "api_key_required": false,
          "method_request_parameters": {},
          "integration_request_body_template": {},
          "responses": [],
          "integration_responses": [],
          "default_error_pattern": true,
          "integration_passthrough_behavior": "WHEN_NO_TEMPLATES"
        }
      },
      "/auth/sign-out": {
        "enable_cors": {
          "state": true
        },
        "POST": {
          "enable_proxy": true,
          "authorization_type": "authorizer",
          "authorization_scopes": [
            "aws.cognito.signin.user.admin"
          ],
          "integration_type": "lambda",
          "lambda_name": "lambda_example",
          "api_key_required": false,
          "method_request_parameters": {},
          "integration_request_body_template": {},
          "responses": [],
          "integration_responses": [],
          "default_error_pattern": true,
          "integration_passthrough_behavior": "WHEN_NO_TEMPLATES"
        }
      }
    }
  }
}
