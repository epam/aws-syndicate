{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "lambda-cognito-api-gateway-oauth-scopes",
    "description": "Postman collection for the Python lambda-cognito-api-gateway-oauth-scopes example.\n\nDemonstrates API Gateway Cognito authorizer behavior with ID tokens vs access tokens.\n\n## Quick start\n\n1. Set `baseUrl` to your deployed API Gateway invoke URL (stage `api`).\n2. Run **Auth → sign-up**, then **Auth → sign-in**.\n3. Sign-in stores `idToken`, `accessToken`, and `refreshToken` automatically.\n4. For secured object endpoints, set `bearerToken` to either `{{idToken}}` or `{{accessToken}}` and observe which endpoints accept which token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/sign-up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"P@ssw0rd\",\n  \"email\": \"newuser@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/sign-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sign-up"
              ]
            },
            "description": "Registers a new user via Cognito AdminCreateUser + AdminSetUserPassword."
          },
          "response": []
        },
        {
          "name": "POST /auth/sign-in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('idToken', body.idToken);",
                  "    pm.collectionVariables.set('accessToken', body.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "    pm.collectionVariables.set('bearerToken', body.idToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"P@ssw0rd\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/sign-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sign-in"
              ]
            },
            "description": "Authenticates a user and stores idToken, accessToken, and refreshToken in collection variables."
          },
          "response": []
        },
        {
          "name": "POST /auth/refresh-token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('idToken', body.idToken);",
                  "    pm.collectionVariables.set('accessToken', body.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"newuser\",\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh-token"
              ]
            },
            "description": "Exchanges a refresh token for new ID and access tokens."
          },
          "response": []
        },
        {
          "name": "POST /auth/sign-out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/sign-out",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "sign-out"
              ]
            },
            "description": "Global sign-out. Requires an access token (scope-protected method)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Objects",
      "item": [
        {
          "name": "GET /objects/public",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/objects/public",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "objects",
                "public"
              ]
            },
            "description": "Unsecured endpoint — no token required."
          },
          "response": []
        },
        {
          "name": "GET /objects/secured-by-id-token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/objects/secured-by-id-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "objects",
                "secured-by-id-token"
              ]
            },
            "description": "Expects an **ID token**. Set `bearerToken` to `{{idToken}}` (works) or `{{accessToken}}` (401)."
          },
          "response": []
        },
        {
          "name": "GET /objects/secured-by-access-token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearerToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/objects/secured-by-access-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "objects",
                "secured-by-access-token"
              ]
            },
            "description": "Expects an **access token** with scope `aws.cognito.signin.user.admin`. Set `bearerToken` to `{{accessToken}}` (works) or `{{idToken}}` (401)."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://your-api-id.execute-api.your-region.amazonaws.com/api"
    },
    {
      "key": "bearerToken",
      "value": ""
    },
    {
      "key": "idToken",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ]
}
